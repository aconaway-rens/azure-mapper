# Azure Mapper - Configuration
#
# This file is OPTIONAL. The app authenticates with whatever identity the host
# already has, via DefaultAzureCredential, which tries in order:
#
#   1. Service-principal environment variables (below)
#   2. Workload identity / managed identity (Azure VMs, AKS, App Service)
#   3. An `az login` session on the host
#
# On a VM with a managed identity or an az login session, copy nothing and set
# nothing — just run the app.

# Service principal — only if you can't use a managed identity or az login.
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Pin to one user-assigned managed identity when the host has several.
# AZURE_CLIENT_ID=managed-identity-client-id

# Local (non-Docker) runs only — Docker serves via gunicorn on 0.0.0.0:8080.
# HOST=127.0.0.1
# PORT=8080
# FLASK_ENV=development
